###############################################
# GAuth Backend - Production Environment
###############################################

# Core Server
GAUTH_PORT=8080
GAUTH_HOST=0.0.0.0
GAUTH_ENV=production

# CORS (production: restrict to production domain only)
GAUTH_CORS_ALLOW=https://gauth.example.com

# Metrics / Observability
GAUTH_METRICS_ENABLED=true
GAUTH_METRICS_PERSIST_PATH=/var/lib/gauth/metrics.db
GAUTH_TRACING_ENABLED=true
GAUTH_TRACING_ENDPOINT=http://jaeger:14268/api/traces
GAUTH_LOG_LEVEL=warn
GAUTH_LOG_FORMAT=json

# Security / Tokens (CRITICAL: Use secure key management)
GAUTH_JWT_SIGNING_KEY=${GAUTH_JWT_SIGNING_KEY}
GAUTH_ENABLE_REPLAY_PROTECTION=true
GAUTH_TOKEN_SIG_MODE=eddsa

# Key Rotation (production: weekly rotation)
GAUTH_KEY_ROTATION_INTERVAL=168h
GAUTH_KEY_ROTATION_AUTO=true

# External Anchoring / Timestamp Authority
GAUTH_ANCHOR_ROTATIONS=true
GAUTH_TSA_ENDPOINT=https://tsa.example.com

# PostgreSQL (required in production)
GAUTH_DB_HOST=${GAUTH_DB_HOST}
GAUTH_DB_PORT=5432
GAUTH_DB_USER=${GAUTH_DB_USER}
GAUTH_DB_PASSWORD=${GAUTH_DB_PASSWORD}
GAUTH_DB_NAME=gauth_production
GAUTH_DB_SSL_MODE=require
GAUTH_DB_MAX_CONNECTIONS=100
GAUTH_DB_IDLE_CONNECTIONS=10
GAUTH_DB_CONNECTION_LIFETIME=3600

# Feature Flags
GAUTH_BETA=0
GAUTH_ENABLE_PROMETHEUS=true
GAUTH_ENABLE_OPENAPI=false

# Development Convenience (disabled in production)
GAUTH_DEV_INDEX=0
GAUTH_DEV_MODE=false

# Rate Limiting (strict for production)
GAUTH_RATE_LIMIT_ENABLED=true
GAUTH_RATE_LIMIT_REQUESTS=100
GAUTH_RATE_LIMIT_WINDOW=60s
GAUTH_RATE_LIMIT_BURST=200

# Health Check
GAUTH_HEALTH_CHECK_ENABLED=true
GAUTH_HEALTH_CHECK_PATH=/health

# TLS/SSL (required in production)
GAUTH_TLS_ENABLED=true
GAUTH_TLS_CERT_PATH=/etc/gauth/tls/cert.pem
GAUTH_TLS_KEY_PATH=/etc/gauth/tls/key.pem
GAUTH_TLS_MIN_VERSION=1.3

# Session Management
GAUTH_SESSION_TIMEOUT=1800
GAUTH_MAX_SESSIONS_PER_USER=5

# Security Headers
GAUTH_SECURITY_HEADERS_ENABLED=true
GAUTH_HSTS_ENABLED=true
GAUTH_CSP_ENABLED=true

# Audit Logging
GAUTH_AUDIT_ENABLED=true
GAUTH_AUDIT_LOG_PATH=/var/log/gauth/audit.log

# Graceful Shutdown
GAUTH_SHUTDOWN_TIMEOUT=30s

# Notes:
# - Production environment with strict security
# - All secrets must be injected via environment variables or secrets manager
# - Never commit actual secret values
# - TLS required, strict CORS, limited rate limits
# - JSON logging for production log aggregation

###############################################
# AgentAuth Backend - Production Environment
###############################################

# Core Server
AGENTAUTH_PORT=8080
AGENTAUTH_HOST=0.0.0.0
AGENTAUTH_ENV=production

# CORS (production: restrict to production domain only)
AGENTAUTH_CORS_ALLOW=https://agentauth.example.com

# Metrics / Observability
AGENTAUTH_METRICS_ENABLED=true
AGENTAUTH_METRICS_PERSIST_PATH=/var/lib/agentauth/metrics.db
AGENTAUTH_TRACING_ENABLED=true
AGENTAUTH_TRACING_ENDPOINT=http://jaeger:14268/api/traces
AGENTAUTH_LOG_LEVEL=warn
AGENTAUTH_LOG_FORMAT=json

# Security / Tokens (CRITICAL: Use secure key management)
AGENTAUTH_JWT_SIGNING_KEY=${AGENTAUTH_JWT_SIGNING_KEY}
AGENTAUTH_ENABLE_REPLAY_PROTECTION=true
AGENTAUTH_TOKEN_SIG_MODE=eddsa

# Key Rotation (production: weekly rotation)
AGENTAUTH_KEY_ROTATION_INTERVAL=168h
AGENTAUTH_KEY_ROTATION_AUTO=true

# External Anchoring / Timestamp Authority
AGENTAUTH_ANCHOR_ROTATIONS=true
AGENTAUTH_TSA_ENDPOINT=https://tsa.example.com

# PostgreSQL (required in production)
AGENTAUTH_DB_HOST=${AGENTAUTH_DB_HOST}
AGENTAUTH_DB_PORT=5432
AGENTAUTH_DB_USER=${AGENTAUTH_DB_USER}
AGENTAUTH_DB_PASSWORD=${AGENTAUTH_DB_PASSWORD}
AGENTAUTH_DB_NAME=agentauth_production
AGENTAUTH_DB_SSL_MODE=require
AGENTAUTH_DB_MAX_CONNECTIONS=100
AGENTAUTH_DB_IDLE_CONNECTIONS=10
AGENTAUTH_DB_CONNECTION_LIFETIME=3600

# Feature Flags
AGENTAUTH_BETA=0
AGENTAUTH_ENABLE_PROMETHEUS=true
AGENTAUTH_ENABLE_OPENAPI=false

# Development Convenience (disabled in production)
AGENTAUTH_DEV_INDEX=0
AGENTAUTH_DEV_MODE=false

# Rate Limiting (strict for production)
AGENTAUTH_RATE_LIMIT_ENABLED=true
AGENTAUTH_RATE_LIMIT_REQUESTS=100
AGENTAUTH_RATE_LIMIT_WINDOW=60s
AGENTAUTH_RATE_LIMIT_BURST=200

# Health Check
AGENTAUTH_HEALTH_CHECK_ENABLED=true
AGENTAUTH_HEALTH_CHECK_PATH=/health

# TLS/SSL (required in production)
AGENTAUTH_TLS_ENABLED=true
AGENTAUTH_TLS_CERT_PATH=/etc/agentauth/tls/cert.pem
AGENTAUTH_TLS_KEY_PATH=/etc/agentauth/tls/key.pem
AGENTAUTH_TLS_MIN_VERSION=1.3

# Session Management
AGENTAUTH_SESSION_TIMEOUT=1800
AGENTAUTH_MAX_SESSIONS_PER_USER=5

# Security Headers
AGENTAUTH_SECURITY_HEADERS_ENABLED=true
AGENTAUTH_HSTS_ENABLED=true
AGENTAUTH_CSP_ENABLED=true

# Audit Logging
AGENTAUTH_AUDIT_ENABLED=true
AGENTAUTH_AUDIT_LOG_PATH=/var/log/agentauth/audit.log

# Graceful Shutdown
AGENTAUTH_SHUTDOWN_TIMEOUT=30s

# Notes:
# - Production environment with strict security
# - All secrets must be injected via environment variables or secrets manager
# - Never commit actual secret values
# - TLS required, strict CORS, limited rate limits
# - JSON logging for production log aggregation

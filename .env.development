###############################################
# AgentAuth Backend - Development Environment
###############################################

# Core Server
AGENTAUTH_PORT=8080
AGENTAUTH_HOST=localhost
AGENTAUTH_ENV=development

# CORS (development: allow local UI origins)
AGENTAUTH_CORS_ALLOW=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Metrics / Observability
AGENTAUTH_METRICS_ENABLED=true
AGENTAUTH_METRICS_PERSIST_PATH=./data/dev/metrics.db
AGENTAUTH_TRACING_ENABLED=false
AGENTAUTH_LOG_LEVEL=debug

# Security / Tokens
AGENTAUTH_JWT_SIGNING_KEY=dev-signing-key-change-in-production
AGENTAUTH_ENABLE_REPLAY_PROTECTION=true
AGENTAUTH_TOKEN_SIG_MODE=eddsa

# Key Rotation
AGENTAUTH_KEY_ROTATION_INTERVAL=720h
AGENTAUTH_KEY_ROTATION_AUTO=false

# External Anchoring / Timestamp Authority
AGENTAUTH_ANCHOR_ROTATIONS=false
AGENTAUTH_TSA_ENDPOINT=

# PostgreSQL (optional persistence)
AGENTAUTH_DB_HOST=localhost
AGENTAUTH_DB_PORT=5432
AGENTAUTH_DB_USER=agentauth_dev
AGENTAUTH_DB_PASSWORD=dev-password-please-change
AGENTAUTH_DB_NAME=agentauth_dev

# Feature Flags
AGENTAUTH_BETA=1
AGENTAUTH_ENABLE_PROMETHEUS=true
AGENTAUTH_ENABLE_OPENAPI=true

# Development Convenience
AGENTAUTH_DEV_INDEX=1
AGENTAUTH_DEV_MODE=true

# Rate Limiting (relaxed for development)
AGENTAUTH_RATE_LIMIT_ENABLED=false
AGENTAUTH_RATE_LIMIT_REQUESTS=1000
AGENTAUTH_RATE_LIMIT_WINDOW=60s

# Health Check
AGENTAUTH_HEALTH_CHECK_ENABLED=true
AGENTAUTH_HEALTH_CHECK_PATH=/health

# Notes:
# - Development environment with relaxed security
# - Detailed logging enabled
# - Rate limiting disabled for testing

###############################################
# GAuth Backend - Development Environment
###############################################

# Core Server
GAUTH_PORT=8080
GAUTH_HOST=localhost
GAUTH_ENV=development

# CORS (development: allow local UI origins)
GAUTH_CORS_ALLOW=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Metrics / Observability
GAUTH_METRICS_ENABLED=true
GAUTH_METRICS_PERSIST_PATH=./data/dev/metrics.db
GAUTH_TRACING_ENABLED=false
GAUTH_LOG_LEVEL=debug

# Security / Tokens
GAUTH_JWT_SIGNING_KEY=dev-signing-key-change-in-production
GAUTH_ENABLE_REPLAY_PROTECTION=true
GAUTH_TOKEN_SIG_MODE=eddsa

# Key Rotation
GAUTH_KEY_ROTATION_INTERVAL=720h
GAUTH_KEY_ROTATION_AUTO=false

# External Anchoring / Timestamp Authority
GAUTH_ANCHOR_ROTATIONS=false
GAUTH_TSA_ENDPOINT=

# PostgreSQL (optional persistence)
GAUTH_DB_HOST=localhost
GAUTH_DB_PORT=5432
GAUTH_DB_USER=gauth_dev
GAUTH_DB_PASSWORD=dev-password-please-change
GAUTH_DB_NAME=gauth_dev

# Feature Flags
GAUTH_BETA=1
GAUTH_ENABLE_PROMETHEUS=true
GAUTH_ENABLE_OPENAPI=true

# Development Convenience
GAUTH_DEV_INDEX=1
GAUTH_DEV_MODE=true

# Rate Limiting (relaxed for development)
GAUTH_RATE_LIMIT_ENABLED=false
GAUTH_RATE_LIMIT_REQUESTS=1000
GAUTH_RATE_LIMIT_WINDOW=60s

# Health Check
GAUTH_HEALTH_CHECK_ENABLED=true
GAUTH_HEALTH_CHECK_PATH=/health

# Notes:
# - Development environment with relaxed security
# - Detailed logging enabled
# - Rate limiting disabled for testing

# Frontend environment example
# Relative API base (proxied by Vite dev server to backend :8080)
VITE_API_BASE_URL=/api/v1
# Optionally override backend during integration against remote host
# VITE_API_BASE_URL=https://your-tunnel-domain.example/api/v1

# Additional placeholders (uncomment as needed)
# VITE_ENABLE_DEBUG=1
# VITE_DEFAULT_CLIENT_ID=demo-client

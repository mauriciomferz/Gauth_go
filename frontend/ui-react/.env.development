# AgentAuth Frontend - Development Environment
# Vite dev server proxies API requests to local backend

# API Configuration
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT=30000

# Environment
VITE_ENV=development

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_BETA_FEATURES=true

# UI Configuration
VITE_AUTO_REFRESH_METRICS=true
VITE_METRICS_REFRESH_INTERVAL=5000
VITE_DEFAULT_PAGE_SIZE=10

# Development Tools
VITE_SHOW_DEV_TOOLS=true
VITE_ENABLE_LOGGING=true

# Default Values
VITE_DEFAULT_CLIENT_ID=demo-client

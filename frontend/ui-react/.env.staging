# AgentAuth Frontend - Staging Environment

# API Configuration (points to staging backend)
VITE_API_BASE_URL=https://staging-api.agentauth.example.com/api/v1
VITE_API_TIMEOUT=30000

# Environment
VITE_ENV=staging

# Feature Flags
VITE_ENABLE_DEBUG=false
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_BETA_FEATURES=true

# UI Configuration
VITE_AUTO_REFRESH_METRICS=true
VITE_METRICS_REFRESH_INTERVAL=10000
VITE_DEFAULT_PAGE_SIZE=20

# Development Tools
VITE_SHOW_DEV_TOOLS=false
VITE_ENABLE_LOGGING=true

# Analytics (optional)
VITE_ANALYTICS_ENABLED=false

# Default Values
VITE_DEFAULT_CLIENT_ID=staging-client

# GAuth Staging - Quick Start Environment
# Generated: December 28, 2025

# JWT Signing Key (generate with: openssl rand -hex 32)
export GAUTH_JWT_SIGNING_KEY=$(openssl rand -hex 32)

# Database Configuration (using docker-compose defaults)
export GAUTH_DB_HOST=postgres
export GAUTH_DB_USER=gauth
export GAUTH_DB_PASSWORD=gauth_dev_password
export GAUTH_DB_NAME=gauth

# Server
export GAUTH_PORT=8080
export GAUTH_ENV=staging
export GAUTH_LOG_LEVEL=info

# Enable features
export GAUTH_METRICS_ENABLED=true
export GAUTH_ENABLE_PROMETHEUS=true

# Audit Export
export AUDIT_EXPORT_DIR=/tmp/gauth-audit-exports

echo "Environment configured for staging deployment"
echo "JWT Signing Key: $GAUTH_JWT_SIGNING_KEY"

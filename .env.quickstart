# AgentAuth Staging - Quick Start Environment
# Generated: December 28, 2025

# JWT Signing Key (generate with: openssl rand -hex 32)
export AGENTAUTH_JWT_SIGNING_KEY=$(openssl rand -hex 32)

# Database Configuration (using docker-compose defaults)
export AGENTAUTH_DB_HOST=postgres
export AGENTAUTH_DB_USER=agentauth
export AGENTAUTH_DB_PASSWORD=agentauth_dev_password
export AGENTAUTH_DB_NAME=agentauth

# Server
export AGENTAUTH_PORT=8080
export AGENTAUTH_ENV=staging
export AGENTAUTH_LOG_LEVEL=info

# Enable features
export AGENTAUTH_METRICS_ENABLED=true
export AGENTAUTH_ENABLE_PROMETHEUS=true

# Audit Export
export AUDIT_EXPORT_DIR=/tmp/agentauth-audit-exports

echo "Environment configured for staging deployment"
echo "JWT Signing Key: $AGENTAUTH_JWT_SIGNING_KEY"

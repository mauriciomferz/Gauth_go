###############################################
# AgentAuth Backend - Staging Environment
###############################################

# Core Server
AGENTAUTH_PORT=8080
AGENTAUTH_HOST=0.0.0.0
AGENTAUTH_ENV=staging

# CORS (staging: restrict to staging domain)
AGENTAUTH_CORS_ALLOW=https://staging.agentauth.example.com

# Metrics / Observability
AGENTAUTH_METRICS_ENABLED=true
AGENTAUTH_METRICS_PERSIST_PATH=/var/lib/agentauth/metrics.db
AGENTAUTH_TRACING_ENABLED=true
AGENTAUTH_TRACING_ENDPOINT=http://jaeger:14268/api/traces
AGENTAUTH_LOG_LEVEL=info

# Security / Tokens
AGENTAUTH_ENABLE_REPLAY_PROTECTION=true
AGENTAUTH_TOKEN_SIG_MODE=eddsa

# Key Rotation
AGENTAUTH_KEY_ROTATION_INTERVAL=168h
AGENTAUTH_KEY_ROTATION_AUTO=true

# External Anchoring / Timestamp Authority
AGENTAUTH_ANCHOR_ROTATIONS=true
AGENTAUTH_TSA_ENDPOINT=https://staging-tsa.example.com

# PostgreSQL (required in staging)
AGENTAUTH_DB_PORT=5432
AGENTAUTH_DB_NAME=agentauth_staging
AGENTAUTH_DB_SSL_MODE=require

# Feature Flags
AGENTAUTH_BETA=1
AGENTAUTH_ENABLE_PROMETHEUS=true
AGENTAUTH_ENABLE_OPENAPI=true

# Development Convenience
AGENTAUTH_DEV_INDEX=0
AGENTAUTH_DEV_MODE=false

# Rate Limiting (moderate for staging)
AGENTAUTH_RATE_LIMIT_ENABLED=true
AGENTAUTH_RATE_LIMIT_REQUESTS=500
AGENTAUTH_RATE_LIMIT_WINDOW=60s

# Health Check
AGENTAUTH_HEALTH_CHECK_ENABLED=true
AGENTAUTH_HEALTH_CHECK_PATH=/health

# TLS/SSL
AGENTAUTH_TLS_ENABLED=true
AGENTAUTH_TLS_CERT_PATH=/etc/agentauth/tls/cert.pem
AGENTAUTH_TLS_KEY_PATH=/etc/agentauth/tls/key.pem

# Session Management
AGENTAUTH_SESSION_TIMEOUT=3600
AGENTAUTH_MAX_SESSIONS_PER_USER=10

# Notes:
# - Staging environment mirrors production
# - Use environment variables for secrets (via CI/CD or secrets manager)
# - TLS enabled, proper CORS restrictions
AGENTAUTH_JWT_SIGNING_KEY=71649cffe3fabb49f17aef43dcae8c342fff5e820ad9af54c78e3938fed489d6

# Quick production Dockerfile for AgentAuth Web Server
# Uses pre-built binary to avoid CGO cross-compilation issues

FROM alpine:3.19

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    libstdc++ \
    libgcc

# Create non-root user
RUN addgroup -g 1000 gauth && \
    adduser -D -u 1000 -G gauth gauth

WORKDIR /app

# Copy pre-built binary from local
COPY bin/web-server /app/web-server

# Copy web assets
COPY web/templates /app/web/templates
COPY web/static /app/web/static
COPY web/static_ui /app/web/static_ui

# Create necessary directories
RUN mkdir -p /app/data /app/logs && \
    chown -R gauth:gauth /app

USER gauth

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["/app/web-server", "-healthcheck"]

ENV GAUTH_WEB_PORT=8080 \
    GAUTH_LOG_LEVEL=info \
    GAUTH_ENV=production \
    GAUTH_HEALTH_URL=http://localhost:8080/api/v1/beta/health

ENTRYPOINT ["/app/web-server"]
CMD []

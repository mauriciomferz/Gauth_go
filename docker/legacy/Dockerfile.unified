###############################################
# Unified Multi-Stage Dockerfile (Draft)
# Goal: Consolidate variant Dockerfiles into one configurable build.
# Usage Examples:
#  - Production (CGO + assets):
#    docker build --target runtime -t gauth:prod \
#      --build-arg BUILD_MODE=production --build-arg WITH_UI=1 .
#  - Minimal (static, scratch):
#    docker build --target minimal -t gauth:minimal \
#      --build-arg BUILD_MODE=minimal .
#  - Dev (hot reload optional future integration):
#    docker build --target dev -t gauth:dev --build-arg BUILD_MODE=dev .
###############################################

ARG GO_VERSION=1.25.3
ARG ALPINE_VERSION=3.19
ARG BUILD_MODE=production   # production|minimal|dev
ARG WITH_UI=0               # 1 to bundle frontend build (requires node)
ARG TARGETARCH=amd64

###############################################
# Stage: base - common dependencies
###############################################
FROM golang:${GO_VERSION}-alpine AS base
# Pinned package versions for reproducibility (adjust as Alpine base updates)
ARG APK_CA_CERTS_VERSION=20240226-r0
ARG APK_TZDATA_VERSION=2024a-r1
ARG APK_GIT_VERSION=2.45.2-r0
ARG APK_BUILD_BASE_VERSION=0.5-r3
RUN apk add --no-cache \
    ca-certificates=${APK_CA_CERTS_VERSION} \
    tzdata=${APK_TZDATA_VERSION} \
    git=${APK_GIT_VERSION} \
    build-base=${APK_BUILD_BASE_VERSION}
WORKDIR /src
COPY go.mod go.sum ./
ENV GOWORK=off
RUN go mod download
COPY . .

###############################################
# Stage: ui-build (optional) - Vite asset build
###############################################
FROM node:22-alpine AS ui-build
WORKDIR /ui
COPY web/ui-react/package*.json ./
RUN npm install --no-audit --no-fund
COPY web/ui-react/ .
RUN npm run build || echo "(UI build skipped or failed; ensure scripts)"

###############################################
# Stage: build-production (CGO enabled)
###############################################
FROM base AS build-production
RUN echo "=== Building (production) ===" && \
    CGO_ENABLED=1 GOOS=linux GOARCH=${TARGETARCH} go build -ldflags='-w -s' -o /out/web-server ./cmd/web-server
COPY --from=ui-build /ui/dist /out/ui-dist

###############################################
# Stage: build-minimal (static, no CGO)
###############################################
FROM base AS build-minimal
RUN echo "=== Building (minimal static) ===" && \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -ldflags='-w -s -extldflags "-static"' -o /out/web-server ./cmd/web-server

###############################################
# Stage: runtime (production alpine)
###############################################
FROM alpine:${ALPINE_VERSION} AS runtime
ARG APK_CA_CERTS_VERSION=20240226-r0
ARG APK_TZDATA_VERSION=2024a-r1
ARG APK_LIBSTDCPP_VERSION=13.2.1_git20240309-r0
ARG APK_LIBGCC_VERSION=13.2.1_git20240309-r0
ARG APK_CURL_VERSION=8.7.1-r0
RUN apk add --no-cache \
    ca-certificates=${APK_CA_CERTS_VERSION} \
    tzdata=${APK_TZDATA_VERSION} \
    libstdc++=${APK_LIBSTDCPP_VERSION} \
    libgcc=${APK_LIBGCC_VERSION} \
    curl=${APK_CURL_VERSION}
WORKDIR /app
COPY --from=build-production /out/web-server ./web-server
COPY --from=build-production /out/ui-dist ./web/ui-dist
RUN addgroup -g 1000 gauth && adduser -D -u 1000 -G gauth gauth && \
    mkdir -p logs data && chown -R gauth:gauth /app
USER gauth
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD ["/app/web-server", "-healthcheck"]
ENTRYPOINT ["/app/web-server"]

###############################################
# Stage: minimal (scratch)
###############################################
FROM scratch AS minimal
COPY --from=build-minimal /out/web-server /web-server
EXPOSE 8080
HEALTHCHECK CMD ["/web-server", "-healthcheck"]
ENTRYPOINT ["/web-server"]

###############################################
# Stage: dev (alpine + tooling) - future hot reload support
###############################################
FROM alpine:${ALPINE_VERSION} AS dev
ARG APK_CA_CERTS_VERSION=20240226-r0
ARG APK_TZDATA_VERSION=2024a-r1
ARG APK_BASH_VERSION=5.2.26-r0
ARG APK_CURL_VERSION=8.7.1-r0
RUN apk add --no-cache \
    ca-certificates=${APK_CA_CERTS_VERSION} \
    tzdata=${APK_TZDATA_VERSION} \
    bash=${APK_BASH_VERSION} \
    curl=${APK_CURL_VERSION}
WORKDIR /app
COPY --from=build-production /out/web-server ./web-server
COPY --from=build-production /out/ui-dist ./web/ui-dist
EXPOSE 8080
ENTRYPOINT ["/app/web-server"]

###############################################
# Final selection logic (documentation only)
# docker build --target runtime ... (production)
# docker build --target minimal ... (static minimal)
# docker build --target dev ... (development baseline)
###############################################

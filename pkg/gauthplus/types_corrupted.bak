 ([]*AICapabilityAssessment, error)	// GetExpiringAssessments returns assessments expiring soon		CheckCapabilityMatch(ctx context.Context, agentID string, requirements *CapabilityRequirements) (bool, []string, error)	// CheckCapabilityMatch verifies agent meets PoA requirements		GetLatestAssessment(ctx context.Context, agentID string) (*AICapabilityAssessment, error)	// GetLatestAssessment returns most recent assessment for agent		CreateAssessment(ctx context.Context, assessment *AICapabilityAssessment) error	// CreateAssessment creates new capability assessmenttype CapabilityAssessmentService interface {// CapabilityAssessmentService handles AI capability evaluations}	GetViolationsBySeverity(ctx context.Context, minSeverity string) ([]*FiduciaryDutyViolation, error)	// GetViolationsBySeverity returns violations above severity threshold		ResolveViolation(ctx context.Context, violationID, reviewedBy, notes string) error	// ResolveViolation marks violation as resolved		GetViolations(ctx context.Context, poaID, agentID string) ([]*FiduciaryDutyViolation, error)	// GetViolations returns violations for agent or PoA		RecordViolation(ctx context.Context, violation *FiduciaryDutyViolation) error	// RecordViolation records a fiduciary duty breachtype FiduciaryDutyService interface {// FiduciaryDutyService tracks and manages fiduciary duties}	GetPendingApprovals(ctx context.Context, approverID string) ([]*DualControlApproval, error)	// GetPendingApprovals returns approvals awaiting decision		CheckApprovalStatus(ctx context.Context, approvalID string) (string, error) // approved, rejected, pending	// CheckApprovalStatus checks if threshold met		RejectAction(ctx context.Context, approvalID, approverID, comments string) error	// RejectAction records approver's rejection		ApproveAction(ctx context.Context, approvalID, approverID, comments string) error	// ApproveAction records approver's approval		RequestApproval(ctx context.Context, approval *DualControlApproval) (string, error)	// RequestApproval initiates approval workflowtype DualControlService interface {// DualControlService handles second-level approvals}	CheckMaxDepthExceeded(ctx context.Context, sourceAgentID string, currentDepth int) (bool, error)	// CheckMaxDepthExceeded checks if adding delegation would exceed max depth		GetDelegationChain(ctx context.Context, agentID string) ([]*AIDelegation, error)	// GetDelegationChain returns full delegation chain		RevokeDelegation(ctx context.Context, delegationID, revokedBy, reason string) error	// RevokeDelegation revokes an active delegation		ValidateDelegation(ctx context.Context, sourceAgentID, targetAgentID string, scope []string, depth int) error	// ValidateDelegation checks if delegation is allowed per policy		CreateDelegation(ctx context.Context, delegation *AIDelegation) error	// CreateDelegation creates new AI-to-AI delegationtype DelegationService interface {// DelegationService handles AI-to-AI delegations}	ListSuccessorHistory(ctx context.Context, poaID string) ([]*SuccessorActivation, error)	// ListSuccessorHistory returns activation history		GetActiveSuccessor(ctx context.Context, poaID string) (*SuccessorActivation, error)	// GetActiveSuccessor returns current successor activation if any		DeactivateSuccessor(ctx context.Context, activationID, deactivatedBy string) error	// DeactivateSuccessor returns control to primary AI		ActivateSuccessor(ctx context.Context, poaID, primaryAgentID, successorAgentID, reason, activatedBy string) (*SuccessorActivation, error)	// ActivateSuccessor activates the successor AI when primary failstype SuccessorManagementService interface {// SuccessorManagementService handles successor AI activation and management}	UpdatedAt               time.Time          `json:"updated_at"`	CreatedAt               time.Time          `json:"created_at"`	SupersededBy            string             `json:"superseded_by,omitempty"`	ValidUntil              time.Time          `json:"valid_until"`	AssessedBy              string             `json:"assessed_by"`	RecommendedRestrictions []string           `json:"recommended_restrictions,omitempty"`	Limitations             []string           `json:"limitations,omitempty"`	Certifications          []string           `json:"certifications"`	CertificationStatus     string             `json:"certification_status"` // uncertified, pending, certified, expired	RiskScore               float64            `json:"risk_score"` // 0.00 to 1.00	CapabilityDomains       map[string]float64 `json:"capability_domains"` // domain -> score (0.0-1.0)	CapabilityLevel         string             `json:"capability_level"` // L0 through L5	AssessmentDate          time.Time          `json:"assessment_date"`	AgentID                 string             `json:"agent_id"`	ID                      string             `json:"id"`type AICapabilityAssessment struct {// AICapabilityAssessment represents periodic AI capability evaluation}	UpdatedAt            time.Time              `json:"updated_at"`	CreatedAt            time.Time              `json:"created_at"`	Evidence             map[string]interface{} `json:"evidence,omitempty"`	Consequences         map[string]interface{} `json:"consequences,omitempty"`	ResolutionNotes      string                 `json:"resolution_notes,omitempty"`	ResolutionStatus     string                 `json:"resolution_status"` // open, investigating, resolved, dismissed	ReviewedAt           *time.Time             `json:"reviewed_at,omitempty"`	ReviewedBy           string                 `json:"reviewed_by,omitempty"`	DetectedBy           string                 `json:"detected_by"`	DetectedAt           time.Time              `json:"detected_at"`	Severity             string                 `json:"severity"` // minor, moderate, major, critical	ViolationDescription string                 `json:"violation_description"`	DutyType             string                 `json:"duty_type"` // care, loyalty, good_faith, disclosure, confidentiality	AgentID              string                 `json:"agent_id"`	POAID                string                 `json:"poa_id"`	ID                   string                 `json:"id"`type FiduciaryDutyViolation struct {// FiduciaryDutyViolation tracks duty breaches}	Weight       int       `json:"weight,omitempty"` // For weighted voting	Comments     string    `json:"comments,omitempty"`	ApprovedAt   time.Time `json:"approved_at"`	ApproverID   string    `json:"approver_id"`type ApprovalRecord struct {// ApprovalRecord tracks individual approver decisions}	UpdatedAt           time.Time              `json:"updated_at"`	CreatedAt           time.Time              `json:"created_at"`	Metadata            map[string]interface{} `json:"metadata,omitempty"`	ExpiresAt           *time.Time             `json:"expires_at,omitempty"`	DecisionFinalizedAt *time.Time             `json:"decision_finalized_at,omitempty"`	RejectedBy          []ApprovalRecord       `json:"rejected_by"`	ApprovedBy          []ApprovalRecord       `json:"approved_by"`	Status              string                 `json:"status"` // pending, approved, rejected, expired	ApprovalThreshold   string                 `json:"approval_threshold"` // all, majority, quorum, weighted	RequiredApprovers   int                    `json:"required_approvers"`	RequestedAt         time.Time              `json:"requested_at"`	RequestedBy         string                 `json:"requested_by"`	ActionDescription   string                 `json:"action_description"`	ActionType          string                 `json:"action_type"`	POAID               string                 `json:"poa_id"`	ID                  string                 `json:"id"`type DualControlApproval struct {// DualControlApproval represents a second-level approval workflow}	UpdatedAt         time.Time              `json:"updated_at"`	CreatedAt         time.Time              `json:"created_at"`	RevocationReason  string                 `json:"revocation_reason,omitempty"`	RevokedBy         string                 `json:"revoked_by,omitempty"`	RevokedAt         *time.Time             `json:"revoked_at,omitempty"`	DelegationPolicy  *DelegationPolicy      `json:"delegation_policy,omitempty"`	Status            string                 `json:"status"` // active, revoked, expired	ValidUntil        time.Time              `json:"valid_until"`	ValidFrom         time.Time              `json:"valid_from"`	MaxAllowedDepth   int                    `json:"max_allowed_depth"`	DelegationDepth   int                    `json:"delegation_depth"`	DelegatedScope    []string               `json:"delegated_scope"`	TargetAgentID     string                 `json:"target_agent_id"`	SourceAgentID     string                 `json:"source_agent_id"`	SourcePOAID       string                 `json:"source_poa_id"`	ID                string                 `json:"id"`type AIDelegation struct {// AIDelegation represents an AI-to-AI delegation}	UpdatedAt         time.Time `json:"updated_at"`	CreatedAt         time.Time `json:"created_at"`	Metadata          map[string]interface{} `json:"metadata,omitempty"`	Status            string    `json:"status"` // active, deactivated, superseded	DeactivatedBy     string    `json:"deactivated_by,omitempty"`	DeactivatedAt     *time.Time `json:"deactivated_at,omitempty"`	ActivatedBy       string    `json:"activated_by"`	ActivatedAt       time.Time `json:"activated_at"`	ActivationReason  string    `json:"activation_reason"` // unavailable, failure, manual, timeout	SuccessorAgentID  string    `json:"successor_agent_id"`	PrimaryAgentID    string    `json:"primary_agent_id"`	POAID             string    `json:"poa_id"`	ID                string    `json:"id"`type SuccessorActivation struct {// SuccessorActivation represents a successor AI taking over}	CertificationIDs []string           `json:"certification_ids"`  // Required certification IDs	RequiresCert     bool               `json:"requires_cert"`      // Requires formal certification	MaxRiskScore     float64            `json:"max_risk_score"`     // Maximum acceptable risk (0.0-1.0)	RequiredDomains  map[string]float64 `json:"required_domains"`   // domain -> min_score (0.0-1.0)	MinimumLevel     string             `json:"minimum_level"`      // "L0" through "L5"type CapabilityRequirements struct {// CapabilityRequirements specifies required AI capability levels)	ObligationProhibitive ObligationType = "prohibitive"	// ObligationProhibitive - AI is explicitly forbidden from certain actions	ObligationMandatory ObligationType = "mandatory"	// ObligationMandatory - "need-to-do" - AI must perform certain actions	ObligationPermissive ObligationType = "permissive"	// ObligationPermissive - "do-unless" - AI can act unless explicitly prohibitedconst (type ObligationType string// ObligationType defines the nature of AI authorization}	ViolationConseq     string   `json:"violation_consequences"` // "warn", "suspend", "revoke"	SpecificDuties      []string `json:"specific_duties"`        // Industry/jurisdiction specific duties	DutyOfConfidential  bool     `json:"duty_of_confidential"`   // Maintain confidentiality	DutyOfDisclosure    bool     `json:"duty_of_disclosure"`     // Disclose conflicts of interest	DutyOfGoodFaith     bool     `json:"duty_of_good_faith"`     // Act honestly and in good faith	DutyOfLoyalty       bool     `json:"duty_of_loyalty"`        // Act in principal's best interest	DutyOfCare          bool     `json:"duty_of_care"`           // Act with reasonable care and diligencetype FiduciaryDuties struct {// FiduciaryDuties represents duties the AI agent must uphold}	TimeRestriction  string   `json:"time_restriction"`   // "maintain", "reduce_only", "extend_allowed"	ScopeRestriction string   `json:"scope_restriction"`  // "maintain", "reduce_only", "none"	RequiresApproval bool     `json:"requires_approval"`  // Whether delegation needs human approval	AllowedDelegates []string `json:"allowed_delegates"`  // Whitelist of allowed delegate agent IDs	MaxDepth         int      `json:"max_depth"`          // Maximum delegation chain depth	CanDelegate      bool     `json:"can_delegate"`type DelegationPolicy struct {// DelegationPolicy defines rules for AI-to-AI delegation)	"time"	"fmt"	"encoding/json"	"context"
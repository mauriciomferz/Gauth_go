# Single-stage Dockerfile for GAuth Web Server  
# Avoids multi-platform manifest issues by using golang base directly

FROM golang:1.25-alpine

# Install runtime and build dependencies
RUN apk add --no-cache \
    gcc \
    g++ \
    musl-dev \
    ca-certificates \
    tzdata \
    git

# Create non-root user
RUN addgroup -g 1000 gauth && \
    adduser -D -u 1000 -G gauth gauth

WORKDIR /app

# Copy go modules
COPY go.mod go.sum ./
ENV GOWORK=off
RUN go mod download

# Copy source
COPY . .

# Build for amd64 (the platform this container will run on)
RUN CGO_ENABLED=1 go build -v -o /app/web-server ./cmd/web-server

# Change ownership
RUN chown -R gauth:gauth /app && \
    mkdir -p /app/data /app/logs && \
    chown -R gauth:gauth /app/data /app/logs

USER gauth

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["/app/web-server", "-healthcheck"]

ENV GAUTH_WEB_PORT=8080 \
    GAUTH_LOG_LEVEL=info \
    GAUTH_ENV=production \
    GAUTH_HEALTH_URL=http://localhost:8080/api/v1/beta/health

ENTRYPOINT ["/app/web-server"]
CMD []

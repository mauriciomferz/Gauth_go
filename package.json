    "ui:report": "playwright show-report"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "eslint": "^8.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "@playwright/test": "^1.48.0"
  }
}

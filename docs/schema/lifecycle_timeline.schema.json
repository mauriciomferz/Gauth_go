{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gimelfoundation.com/schema/lifecycle_timeline.json",
  "title": "LifecycleTimelineSnapshot",
  "type": "object",
  "required": ["success", "events"],
  "properties": {
    "success": {"type": "boolean"},
    "events": {
      "type": "array",
      "items": {"$ref": "#/definitions/LifecycleEvent"}
    },
    "count": {"type": "integer", "minimum": 0}
  },
  "definitions": {
    "LifecycleEvent": {
      "type": "object",
      "required": ["entity_type", "entity_id", "old_status", "new_status", "outcome", "reason", "latency_ns", "at"],
      "properties": {
        "entity_type": {"type": "string", "enum": ["token", "delegation"]},
        "entity_id": {"type": "string", "minLength": 1},
        "old_status": {"type": "string"},
        "new_status": {"type": "string"},
        "outcome": {"type": "string", "enum": ["success", "failure", "noop"]},
        "reason": {"type": "string", "enum": ["init", "status_change", "noop", "invalid_transition", "unsupported_status", "invalid_payload", "not_found", "maintenance", "rate_limited", "policy_violation"]},
        "latency_ns": {"type": "integer", "minimum": 0},
        "at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

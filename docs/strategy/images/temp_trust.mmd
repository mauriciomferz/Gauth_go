graph TD
    %% Nodes
    Factory["Factory Root Key\nBurned into TPM"] 
    Fleet["Fleet Identity Key\nCloud Provisioned"]
    Device["Device PoA\nMission Scoped"]
    Session["Session Key\nEphemeral"]
    
    %% Hierarchy
    Factory ==>|Hardware Derived| Fleet
    Fleet -->|Signed Delegation| Device
    Device -.->|Runtime Derived| Session
    
    %% Styling
    style Factory fill:#e0e0e0,stroke:#212121,stroke-width:3px,color:#000
    style Fleet fill:#bbdefb,stroke:#0d47a1,stroke-width:2px,color:#000
    style Device fill:#c8e6c9,stroke:#1b5e20,stroke-width:2px,color:#000
    style Session fill:#fff9c4,stroke:#fbc02d,stroke-width:1px,stroke-dasharray: 5 5

# Minimal Dockerfile for beta demonstration / debug builds of GAuth
# Purpose: Fast, low-surface build useful for local debugging and CI fallback.
# This intentionally omits extra packages, healthchecks, non-root user setup,
# and aggressive binary size stripping to reduce moving parts when diagnosing
# build issues (e.g., cache key problems, platform quirks, buildx parsing errors).

# REQUIRES Go 1.25.3+ for security patches
FROM golang:1.25.3-alpine AS build
WORKDIR /app

# Only copy what is strictly required for a minimal web server binary
COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ ./cmd/
COPY pkg/ ./pkg/
COPY internal/ ./internal/
COPY web/ ./web/

# Build the beta web server (no CGO, single arch)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o web-server ./cmd/web-server

FROM scratch
# Copy timezone data & certs from a slim stage if needed later; omitted here for minimalism.
COPY --from=build /app/web-server /web-server

# Minimal non-root user setup (static binary; no /etc/passwd required for most distros)
USER 1001:1001

EXPOSE 8080

# Basic container health check hitting beta health endpoint
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
	CMD ["/web-server", "-healthcheck"]

ENTRYPOINT ["/web-server"]

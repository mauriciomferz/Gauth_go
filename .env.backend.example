###############################################
# AgentAuth Backend Example Environment File
# Copy to .env (never commit secrets)
###############################################

# Core Server
AGENTAUTH_PORT=8080
AGENTAUTH_HOST=localhost

# CORS (development: allow UI origin; production: restrict)
# Comma-separated list, or * for development wildcard
AGENTAUTH_CORS_ALLOW=http://localhost:3000,http://localhost:5173

# Metrics / Observability
AGENTAUTH_METRICS_ENABLED=true
AGENTAUTH_METRICS_PERSIST_PATH=./data/metrics.db
AGENTAUTH_TRACING_ENABLED=false

# Security / Tokens
AGENTAUTH_JWT_SIGNING_KEY=dev-please-change
AGENTAUTH_ENABLE_REPLAY_PROTECTION=true
AGENTAUTH_TOKEN_SIG_MODE=eddsa

# Key Rotation
AGENTAUTH_KEY_ROTATION_INTERVAL=720h
AGENTAUTH_KEY_ROTATION_AUTO=true

# External Anchoring / Timestamp Authority
AGENTAUTH_ANCHOR_ROTATIONS=false
AGENTAUTH_TSA_ENDPOINT=

# PostgreSQL (optional persistence)
AGENTAUTH_DB_HOST=localhost
AGENTAUTH_DB_PORT=5432
AGENTAUTH_DB_USER=agentauth
AGENTAUTH_DB_PASSWORD=dev-password-change-me
AGENTAUTH_DB_NAME=agentauth

# Feature Flags
AGENTAUTH_BETA=1
AGENTAUTH_ENABLE_PROMETHEUS=true
AGENTAUTH_ENABLE_OPENAPI=true

# Development Convenience
AGENTAUTH_DEV_INDEX=1

# Notes:
# - Never use these defaults in production.
# - Rotate AGENTAUTH_JWT_SIGNING_KEY and restrict AGENTAUTH_CORS_ALLOW.
# - Set AGENTAUTH_TSA_ENDPOINT for anchoring if required.

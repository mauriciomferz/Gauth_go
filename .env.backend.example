###############################################
# GAuth Backend Example Environment File
# Copy to .env (never commit secrets)
###############################################

# Core Server
GAUTH_PORT=8080
GAUTH_HOST=localhost

# CORS (development: allow UI origin; production: restrict)
# Comma-separated list, or * for development wildcard
GAUTH_CORS_ALLOW=http://localhost:3000,http://localhost:5173

# Metrics / Observability
GAUTH_METRICS_ENABLED=true
GAUTH_METRICS_PERSIST_PATH=./data/metrics.db
GAUTH_TRACING_ENABLED=false

# Security / Tokens
GAUTH_JWT_SIGNING_KEY=dev-please-change
GAUTH_ENABLE_REPLAY_PROTECTION=true
GAUTH_TOKEN_SIG_MODE=eddsa

# Key Rotation
GAUTH_KEY_ROTATION_INTERVAL=720h
GAUTH_KEY_ROTATION_AUTO=true

# External Anchoring / Timestamp Authority
GAUTH_ANCHOR_ROTATIONS=false
GAUTH_TSA_ENDPOINT=

# PostgreSQL (optional persistence)
GAUTH_DB_HOST=localhost
GAUTH_DB_PORT=5432
GAUTH_DB_USER=gauth
GAUTH_DB_PASSWORD=dev-password-change-me
GAUTH_DB_NAME=gauth

# Feature Flags
GAUTH_BETA=1
GAUTH_ENABLE_PROMETHEUS=true
GAUTH_ENABLE_OPENAPI=true

# Development Convenience
GAUTH_DEV_INDEX=1

# Notes:
# - Never use these defaults in production.
# - Rotate GAUTH_JWT_SIGNING_KEY and restrict GAUTH_CORS_ALLOW.
# - Set GAUTH_TSA_ENDPOINT for anchoring if required.

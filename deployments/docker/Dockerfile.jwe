# AgentAuth Authorization Server with JWE Encryption
# Production-ready Docker image with JWE key management

FROM golang:1.21-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o gauth-server ./cmd/web-server

# Production image
FROM alpine:latest

# Install ca-certificates for HTTPS
RUN apk --no-cache add ca-certificates

# Create non-root user
RUN addgroup -g 1000 gauth && \
    adduser -D -u 1000 -G gauth gauth

# Create directories for keys and config
RUN mkdir -p /etc/gauth/keys && \
    chown -R gauth:gauth /etc/gauth

WORKDIR /home/gauth

# Copy binary from builder
COPY --from=builder /app/gauth-server .
RUN chown gauth:gauth gauth-server

# Switch to non-root user
USER gauth

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Environment variables with defaults
ENV GAUTH_JWE_ENABLED=true \
    GAUTH_JWE_ALGORITHM=RSA-OAEP-256 \
    GAUTH_JWE_ENCRYPTION=A256GCM \
    GAUTH_JWE_PUBLIC_KEY=/etc/gauth/keys/public.pem \
    GAUTH_JWE_PRIVATE_KEY=/etc/gauth/keys/private.pem \
    GAUTH_JWE_KEY_ID=gauth-prod-2025-11 \
    GAUTH_JWE_ROTATION_DAYS=365

# Run the application
CMD ["./gauth-server"]
